#!/bin/sh
set -eu

umask 077
script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
runtime_directory="$repository_root/var/run-private-scanner/bin"

usage() {
    printf '%s\n' \
        'Usage:' \
        '  ./scripts/run-private-scanner [--trading-date YYYY-MM-DD] [--hydration-workers 1|2|4|8] [--open]'
}

seen_date=0
seen_workers=0
seen_open=0
seen_help=0
trading_date=
hydration_workers=8
remaining=$#
while [ "$remaining" -gt 0 ]; do
    argument=$1
    shift
    remaining=$((remaining - 1))
    case "$argument" in
        --trading-date)
            if [ "$seen_date" -ne 0 ]; then
                printf '%s\n' '--trading-date may be supplied only once' >&2
                exit 2
            fi
            if [ "$remaining" -eq 0 ]; then
                printf '%s\n' '--trading-date requires YYYY-MM-DD' >&2
                exit 2
            fi
            seen_date=1
            trading_date=$1
            shift
            remaining=$((remaining - 1))
            ;;
        --hydration-workers)
            if [ "$seen_workers" -ne 0 ]; then
                printf '%s\n' '--hydration-workers may be supplied only once' >&2
                exit 2
            fi
            if [ "$remaining" -eq 0 ]; then
                printf '%s\n' '--hydration-workers requires 1, 2, 4, or 8' >&2
                exit 2
            fi
            seen_workers=1
            hydration_workers=$1
            shift
            remaining=$((remaining - 1))
            case "$hydration_workers" in
                1|2|4|8) ;;
                *)
                    printf '%s\n' '--hydration-workers must be one of 1, 2, 4, or 8' >&2
                    exit 2
                    ;;
            esac
            ;;
        --open)
            if [ "$seen_open" -ne 0 ]; then
                printf '%s\n' '--open may be supplied only once' >&2
                exit 2
            fi
            seen_open=1
            ;;
        --help)
            if [ "$seen_help" -ne 0 ]; then
                printf '%s\n' '--help may be supplied only once' >&2
                exit 2
            fi
            seen_help=1
            ;;
        -*)
            printf 'unknown argument %s\n' "$argument" >&2
            exit 2
            ;;
        *)
            printf 'positional argument %s is not supported\n' "$argument" >&2
            exit 2
            ;;
    esac
done

if [ "$seen_help" -ne 0 ]; then
    if [ "$seen_date" -ne 0 ] || [ "$seen_workers" -ne 0 ] || [ "$seen_open" -ne 0 ]; then
        printf '%s\n' '--help cannot be combined with startup arguments' >&2
        exit 2
    fi
    usage
    exit 0
fi

if [ "$seen_date" -ne 0 ]; then
    validated_date=$(/bin/date -j -f '%Y-%m-%d' "$trading_date" '+%Y-%m-%d' 2>/dev/null) || {
        printf '%s\n' '--trading-date must be a valid date in YYYY-MM-DD form' >&2
        exit 2
    }
    if [ "$validated_date" != "$trading_date" ]; then
        printf '%s\n' '--trading-date must be a valid date in YYYY-MM-DD form' >&2
        exit 2
    fi
fi

# Reconstruct the already-validated public arguments because the POSIX parser
# above consumes its positional parameters. The Go launcher validates them a
# second time before preflight or credential acquisition.
set --
if [ "$seen_date" -ne 0 ]; then
    set -- "$@" --trading-date "$trading_date"
fi
set -- "$@" --hydration-workers "$hydration_workers"
if [ "$seen_open" -ne 0 ]; then
    set -- "$@" --open
fi

mkdir -p "$runtime_directory"

build_pid=
temporary_build_directory=
temporary_launcher=
cleanup_temporary_build() {
    if [ -n "$temporary_launcher" ]; then
        /bin/rm -f "$temporary_launcher"
        temporary_launcher=
    fi
    if [ -n "$temporary_build_directory" ]; then
        /bin/rmdir "$temporary_build_directory" 2>/dev/null || true
        temporary_build_directory=
    fi
}
forward_build_signal() {
    forwarded_signal=$1
    exit_status=$2
    active_build_pid=$build_pid
    if [ -z "$active_build_pid" ]; then
        set +u
        active_build_pid=$!
        set -u
    fi
    if [ -n "$active_build_pid" ]; then
        /bin/kill -"$forwarded_signal" -"$active_build_pid" 2>/dev/null || true
        /bin/sleep 0.1
        /bin/kill -KILL -"$active_build_pid" 2>/dev/null || true
        wait "$active_build_pid" 2>/dev/null || true
    fi
    cleanup_temporary_build
    trap - INT TERM
    exit "$exit_status"
}
trap 'forward_build_signal INT 130' INT
trap 'forward_build_signal TERM 143' TERM
trap cleanup_temporary_build EXIT

temporary_build_directory=$(/usr/bin/mktemp -d "$runtime_directory/.private-scanner-launcher-build.XXXXXX")
temporary_launcher="$temporary_build_directory/private-scanner-launcher"
set -m
(cd "$repository_root" && exec /usr/bin/env -u MASSIVE_API_KEY go build -trimpath -o "$temporary_launcher" ./cmd/private-scanner-launcher) &
build_pid=$!
set +m
set +e
wait "$build_pid"
build_status=$?
set -e
build_pid=
trap - INT TERM
if [ "$build_status" -ne 0 ]; then
    exit "$build_status"
fi
/bin/mv -f "$temporary_launcher" "$runtime_directory/private-scanner-launcher"
temporary_launcher=
/bin/rmdir "$temporary_build_directory"
temporary_build_directory=
trap - EXIT

export PRIVATE_SCANNER_REPO_ROOT="$repository_root"
exec "$runtime_directory/private-scanner-launcher" "$@"
